  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\xiaozhi-esp32-v2\build\esp-idf\esp_driver_sdmmc && C:\esp\esp_idf_v5.5.1\esp_v5.5.1\tools\.espressif\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

