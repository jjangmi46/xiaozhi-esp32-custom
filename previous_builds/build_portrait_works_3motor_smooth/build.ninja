  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\xiaozhi-esp32-v2\build\esp-idf\esp_local_ctrl && C:\esp\esp_idf_v5.5.1\esp_v5.5.1\tools\.espressif\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
